# Microsoft Azure App Registration Credentials
# Get these from Azure Portal > App Registrations > Your App

# Application (client) ID from Azure Portal
MS_CLIENT_ID=your-client-id-here

# Client secret VALUE (not the secret ID) from Azure Portal > Certificates & secrets
MS_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID from Azure Portal > Microsoft Entra ID > Overview
# For single-tenant apps, set this to your tenant GUID so /common is not used.
MS_TENANT_ID=your-tenant-id-here

# Optional: Enable test mode with mock data (true/false)
USE_TEST_MODE=false

# Optional: path to a custom .env file (loaded INSTEAD of the server-folder .env).
# Useful when credentials live in a shared workspace root .env.
# Only server-owned keys (MS_*, OUTLOOK_*, USE_TEST_MODE) are taken from the file;
# everything else in a shared .env is ignored. Variables already set in the
# process environment are never overwritten.
# M365_ENV_FILE=D:/AI-Workspace/.env

# Optional overrides (defaults shown):
# MS_REDIRECT_URI=http://localhost:3333/auth/callback
# MS_SCOPES=offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite Contacts.Read Files.Read Files.ReadWrite Tasks.ReadWrite
